#!/usr/bin/env python3
"""Warm startup baseline; temporary shell state, no tmux boot or local overrides."""
import os
from pathlib import Path
import shutil
import statistics
import subprocess
import tempfile
import time

repo = Path(__file__).resolve().parents[1]
with tempfile.TemporaryDirectory(prefix='dotdotdot-startup-') as directory:
    root = Path(directory)
    config = root/'config'
    config.mkdir()
    (config/'nvim').symlink_to(repo/'nvim', target_is_directory=True)
    actual_config = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home()/'.config')))
    if (actual_config/'dotdotdot/machine.zsh').is_file():
        (config/'dotdotdot').mkdir()
        (config/'dotdotdot/machine.zsh').symlink_to(actual_config/'dotdotdot/machine.zsh')
    theme = actual_config/'dotfiles-theme'
    (config/'dotfiles-theme').write_text(theme.read_text() if theme.is_file() else 'dark\n')
    (root/'.zshrc').write_text('source "$DOTDOTDOT_BENCH_REPO/.zshrc"\n')
    env = os.environ.copy()
    env.update(ZDOTDIR=str(root), XDG_CONFIG_HOME=str(config), XDG_CACHE_HOME=str(root/'cache'),
               XDG_STATE_HOME=str(root/'state'), XDG_RUNTIME_DIR=str(root/'run'),
               NVIM_LOG_FILE=str(root/'nvim.log'), TMUX_BOOTSTRAPPED='1',
               DOTDOTDOT_BENCH_REPO=str(repo))
    for label, command in (
        ('zsh interactive (no tmux boot or local.zsh)', ['/bin/zsh', '-dic', 'exit']),
        ('Neovim configured headless', [shutil.which('nvim'), '--headless', '-n', '-i', 'NONE',
          '+lua if vim.v.errmsg ~= "" then vim.cmd("cquit") end', '+qa']),
    ):
        timings = []
        for attempt in range(9):
            started = time.perf_counter()
            result = subprocess.run(command, env=env, cwd=repo, stdout=subprocess.PIPE,
                                    stderr=subprocess.PIPE, timeout=30)
            elapsed = (time.perf_counter() - started) * 1000
            if result.returncode:
                raise SystemExit(f'{label} failed: {result.stderr.decode(errors="replace")}')
            if attempt >= 2:
                timings.append(elapsed)
        print(f'{label}: median {statistics.median(timings):.0f} ms '
              f'(7 warm starts; range {min(timings):.0f}–{max(timings):.0f} ms)')
print('Temporary state/cache; installed plugin data and machine profile retained. GUI rendering excluded.')
